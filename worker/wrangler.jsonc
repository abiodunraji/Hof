{
  // House of Faridah content Worker. See DEPLOY.md before deploying anything.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hof-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Created 24 Nov 2026 in Biodun's own Cloudflare account (`wrangler kv namespace create CONTENT`).
    // Local development (`npm run dev`) ignores it and uses a throwaway local store.
    { "binding": "CONTENT", "id": "63f908e80e744b4db9a16ba7f65c040f" }
  ]
  // Secrets (never written here): ADMIN_USERNAME, ADMIN_PASSWORD_HASH, SESSION_SECRET.
}
