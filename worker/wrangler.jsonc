{
  // House of Faridah content Worker. See DEPLOY.md before deploying anything.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hof-content",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Replace the id with the one printed by `wrangler kv namespace create CONTENT`.
    // Local development (`npm run dev`) ignores it and uses a throwaway local store.
    { "binding": "CONTENT", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ]
  // Secrets (never written here): ADMIN_USERNAME, ADMIN_PASSWORD_HASH, SESSION_SECRET,
  // RESEND_API_KEY, ENQUIRY_TO, ENQUIRY_FROM. Optional: RESEND_API_BASE (tests only).
}
